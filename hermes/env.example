# Copy the lines you need into ~/.hermes/.env (chmod 600). Never commit the real file.
# `hermes config set KEY value` also writes secrets here, which is the easier route.

# Models (free tiers; one key each, all optional except OpenRouter)
OPENROUTER_API_KEY=sk-or-...            # openrouter.ai, add a one time $10 top up for 1,000 free requests a day
GEMINI_API_KEY=...                      # aistudio.google.com, free
CEREBRAS_API_KEY=...                    # cloud.cerebras.ai, free
GROQ_API_KEY=...                        # console.groq.com, free

# Channel (pick one to start; the wizard writes these for you)
TELEGRAM_BOT_TOKEN=...                  # from @BotFather
TELEGRAM_ALLOWED_USERS=123456789        # Sreekar's numeric Telegram id from @userinfobot
TELEGRAM_HOME_CHANNEL=123456789         # where cron jobs deliver (his own chat id)
# WHATSAPP_ENABLED=true
# WHATSAPP_MODE=self-chat               # self-chat on his own number, or bot on a dedicated number
# WHATSAPP_ALLOWED_USERS=91XXXXXXXXXX   # country code, no plus

# Site
CLOUDFLARE_API_TOKEN=...                # scoped: Pages edit, DNS edit, one zone
CLOUDFLARE_ACCOUNT_ID=...

# Email (himalaya reads its own config at ~/.config/himalaya/config.toml; the app password lives in a chmod 600 file, not here)

# Images (optional; OpenRouter image models use OPENROUTER_API_KEY)
# FAL_KEY=...

# Calls (phase 2, only when Sreekar funds a provider)
# DIAL_API_KEY=...
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# ELEVENLABS_API_KEY=...
